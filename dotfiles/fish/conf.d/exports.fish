set EDITOR nvim
set XDG_DATA_DIRS $XDG_DATA_DIRS:/usr/share:/var/lib/flatpak/exports/share:$HOME/.local/share/flatpak/exports/share
set XDG_SESSION_TYPE "wayland"
set XDG_SESSION_DESKTOP "Hyprland"
set XDG_CURRENT_DESKTOP "Hyprland"
set XDG_DATA_HOME $HOME/.local/share
set DXVK_CONFIG_FILE $HOME/.config/dxvk/dxvk.conf
set TERMCMD "wezterm start --always-new-process"
set TERMFILECHOOSER_PICKER "yazi"
set GTK_USE_PORTAL 1
set GDK_DEBUG "portals"
set -x SHELL bash
