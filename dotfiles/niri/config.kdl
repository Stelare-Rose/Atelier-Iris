spawn-sh-at-startup "awww img /home/Stelare/.config/niri/backgrounds/background.jpg"
spawn-at-startup "waybar"
spawn-at-startup "swaync"
spawn-sh-at-startup "wlsunset -d 1800 -t 5000 -S 8:00 -s 18:00"
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
blur { off; }
environment { GTK_USE_PORTAL "1"; }
overview { backdrop-color "#DECEC1"; }
hotkey-overlay { skip-at-startup; }

output "eDP-1" {
  scale 1.0
}
output "DP-1" {
  mode "1920x1080@165.001"
  scale 1.0
}

input {
  disable-power-key-handling
  workspace-auto-back-and-forth
  touchpad {
    tap
    scroll-method "two-finger"
    accel-profile "flat"
    middle-emulation
  }
  mouse {
    accel-profile "flat"
  }
}
layout {
  gaps 4
  preset-column-widths {
    proportion 0.5
    proportion 1.0
  }
  default-column-width { proportion 1.0; };
  focus-ring {
    on
    width 2
    active-color "#DBB4D3"
    inactive-color "#9BB0DE"
    urgent-color "#CF8282"
  }
  tab-indicator {
    width 2
    gap 2
    length total-proportion=1.0
    position "left"
    place-within-column
  }
  
}
recent-windows { off; }
binds {
  Mod+Shift+Slash { show-hotkey-overlay; }
  
  Mod+Q hotkey-overlay-title="Open Wezterm" { spawn "wezterm"; }
  Mod+Space hotkey-overlay-title="Cycle Rofi" { spawn-sh "pkill rofi || rofi -show combi -combi-modi 'window,drun,ssh' -modi combi -display-drun 'Run'"; }
  Ctrl+Space hotkey-overlay-title="Cycle Rofi" { spawn-sh "pkill rofi || rofi -show combi -combi-modi 'window,drun,ssh' -modi combi -display-drun 'Run'"; }
  Mod+Ctrl+L hotkey-overlay-title="Lock" { spawn "hyprlock"; }

  Mod+O repeat=false { toggle-overview; }

  Mod+C repeat=false { close-window; }

  Mod+Left { focus-column-left; }
  Mod+Down { focus-window-down; }
  Mod+Up { focus-window-up; }
  Mod+Right { focus-column-right; }
  Mod+H { focus-column-left; }
  Mod+J { focus-window-down; }
  Mod+K { focus-window-up; }
  Mod+L { focus-column-right; }

  Mod+Shift+Left { move-column-left; }
  Mod+Shift+Down { move-window-down; }
  Mod+Shift+Up { move-window-up; }
  Mod+Shift+Right { move-column-right; }
  Mod+Shift+H { move-column-left; }
  Mod+Shift+J { move-window-down; }
  Mod+Shift+K { move-window-up; }
  Mod+Shift+L { move-column-right; }

  Mod+Ctrl+Up { focus-workspace-up; }
  Mod+Ctrl+Down { focus-workspace-down; }

  Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
  Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
  Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
  Mod+Ctrl+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }

  Mod+1 { focus-workspace 1; }
  Mod+2 { focus-workspace 2; }
  Mod+3 { focus-workspace 3; }
  Mod+4 { focus-workspace 4; }
  Mod+5 { focus-workspace 5; }
  Mod+6 { focus-workspace 6; }
  Mod+7 { focus-workspace 7; }
  Mod+8 { focus-workspace 8; }
  Mod+9 { focus-workspace 9; }
  Mod+Shift+1 { move-column-to-workspace 1; }
  Mod+Shift+2 { move-column-to-workspace 2; }
  Mod+Shift+3 { move-column-to-workspace 3; }
  Mod+Shift+4 { move-column-to-workspace 4; }
  Mod+Shift+5 { move-column-to-workspace 5; }
  Mod+Shift+6 { move-column-to-workspace 6; }
  Mod+Shift+7 { move-column-to-workspace 7; }
  Mod+Shift+8 { move-column-to-workspace 8; }
  Mod+Shift+9 { move-column-to-workspace 9; }

  Mod+S { focus-workspace "steam"; }
  Mod+Shift+S { move-column-to-workspace "steam"; }

  Mod+D { focus-workspace "chat"; }
  Mod+Shift+D { move-column-to-workspace "chat"; }

  Mod+P { focus-workspace "persistent"; }
  Mod+Shift+P { move-column-to-workspace "persistent"; }

  Mod+Comma { consume-window-into-column; }
  Mod+Period { expel-window-from-column; }

  Mod+R { switch-preset-column-width; } 
  Mod+Shift+R { switch-preset-column-width-back; }

  Mod+Shift+F { fullscreen-window; }
  Mod+M { maximize-column; }
  
  Ctrl+Alt+Delete { quit; }
  Print { screenshot-screen; }
  Mod+Print { screenshot; }
  Shift+Print { screenshot-window; }
}

window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"

workspace "steam"
workspace "chat"
workspace "persistent"

window-rule {
  match at-startup=true app-id=r#"^md\.obsidian\.Obsidian$"#
  open-on-workspace "persistent"
  open-focused false
}
window-rule {
  match at-startup=true app-id=r#"^Pyxis$"#
  open-on-workspace "persistent"
  open-focused false
}
window-rule {
  match at-startup=true app-id=r#"element"#
  open-on-workspace "chat"
  open-focused false
}

spawn-at-startup "obsidian"
spawn-at-startup "Pyxis"
spawn-at-startup "element-desktop"

window-rule {
  match app-id=r#"^steam$"#
  open-on-workspace "steam"
  open-focused false
}
window-rule {
  match app-id=r#"discord"#
  open-on-workspace "chat"
  open-focused false
}
window-rule {
  match app-id=r#"vesktop"#
  open-on-workspace "chat"
  open-focused false
}
window-rule {
  match app-id="zoom"
  open-on-workspace "chat"
}
window-rule {
  match title="annotate_toolbar"
  open-on-workspace "chat"
  open-floating true
  open-focused false
}
window-rule {
  match app-id="librewolf"
  draw-border-with-background false
}
