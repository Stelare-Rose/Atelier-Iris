(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(defvar
  tap-time  250
  hold-time 250
  tt        $tap-time
  ht        $hold-time
)

(defalias
  a-mod     (tap-hold $tt $ht a lalt)
  s-mod     (tap-hold $tt $ht s lctl)
  d-mod     (tap-hold $tt $ht d lmet)
  k-mod     (tap-hold $tt $ht k rmet)
  l-mod     (tap-hold $tt $ht l rctl)
  ;-mod     (tap-hold $tt $ht ; ralt)
  f1-base   (tap-hold $tt $ht f1 (layer-switch gaming))
  f1-gaming (tap-hold $tt $ht f1 (layer-switch base))
  f12-tog   (tap-hold 200 200 f12 (layer-switch disabled))
  f12-back  (tap-hold 200 200 f12 (layer-switch base))
)

(deflayer base
  esc  @f1-base f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  @f12-tog
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps @a-mod @s-mod @d-mod f   g    h    j  @k-mod @l-mod @;-mod '  ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer gaming
  esc  @f1-gaming f2  f3   f4   f5   f6   f7   f8   f9   f10  f11  @f12-tog
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer disabled
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   @f12-back
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX              XX              XX   XX   XX
)
